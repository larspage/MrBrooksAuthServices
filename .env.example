# ============================================================================
# MrBrooksAuthServices - Security Configuration
# ============================================================================
# 
# This file documents all environment variables needed for security.
# Copy to .env.local and fill in your actual values.
# 
# IMPORTANT: Never commit .env.local to version control!

# ============================================================================
# ALLOWED ORIGINS (Security - REQUIRED for production)
# ============================================================================
# Comma-separated list of allowed origins that can call the auth API
# Only requests from these origins will be allowed - all others are BLOCKED
#
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:6010,http://localhost:3000

# Comma-separated list of allowed referers (fallback check)
ALLOWED_REFERERS=localhost:6010,localhost:3000

# ============================================================================
# RATE LIMITING
# ============================================================================
# Maximum requests per IP per window
RATE_LIMIT_REQUESTS=100
# Window size in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================================
# Supabase Configuration
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NOTE: SUPABASE_SERVICE_ROLE_KEY should ONLY be in server-side environment
# Never expose this to client-side code!
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ============================================================================
# Stripe Configuration (sensitive - use secure storage in production)
# ============================================================================
# Note: In production, encrypt STRIPE_SECRET_KEY at rest
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key  # WARNING: Sensitive!
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ============================================================================
# Application Configuration
# ============================================================================
NEXTAUTH_URL=http://localhost:6010
# IMPORTANT: Change this to a secure random string in production!
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-change-this
PORT=6010

# ============================================================================
# Admin Configuration
# ============================================================================
ADMIN_EMAIL=admin@mrbrooks.com

# ============================================================================
# Environment
# ============================================================================
NODE_ENV=development

# ============================================================================
# SECURITY CHECKLIST FOR PRODUCTION
# ============================================================================
# 
# [] Set ALLOWED_ORIGINS to your actual domains (not localhost!)
# [] Generate new NEXTAUTH_SECRET with openssl rand -base64 32
# [] Set NODE_ENV=production
# [] Enable Stripe webhook signature verification
# [] Consider encrypting sensitive keys at rest
# [] Enable database encryption at rest (Supabase settings)
# [] Set up WAF in front of application
# [] Enable audit logging in Supabase
# [] Review and enable all Supabase security policies
# [] Set up monitoring and alerts
# ============================================================================